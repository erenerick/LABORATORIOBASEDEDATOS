insert / delete /update over, pivot


-- INSERT

INSERT INTO CLIENTES
(codcliente, nomcliente, apepcliente, apemcliente, razonsocial, ruc)
VALUES
('C0017','RICHI','Soto','Mayor',NULL,NULL),
('C0018',NULL,NULL,NULL,'Tambo SAC','4564767444')

